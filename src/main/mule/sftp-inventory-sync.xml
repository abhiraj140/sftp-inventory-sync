				<logger level="INFO" doc:name="logger-error-file-created" doc:id="2f270cd0-89d0-410d-8414-6bf2ad302d1b" message="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.errorFilename ++ &quot;has created at &quot; ++ p('sftp.errorPath')]" />
