	<flow name="sftp-inventory-sync-flow" doc:id="35f86b6c-8b46-4ba1-9a0f-71380165b341" >
		<until-successful maxRetries="${retry.attempt}" doc:name="Until Successful" doc:id="76b5fd6c-02db-4973-8774-68053ea22071" millisBetweenRetries="${retry.frequency}">
			<try doc:name="Try" doc:id="a7959357-636c-4db5-b8a0-1b3bc68e88b6">
			<sftp:read doc:name="read-full-inventory-data" doc:id="7e62d2a7-629e-49c7-a716-fcc73c79ccb2" config-ref="SFTP_Config" path="#[p('sftp.source')++&quot;full_inventory_&quot; ++ (now()as String {format: &quot;MM-dd-YY&quot;}) ++&quot;.csv&quot;]" outputMimeType='application/csv; bodystartlinenumber=1; headerlinenumber=0; streaming=true; separator=","; header=true'>
			<non-repeatable-stream />
		</sftp:read>
				<error-handler ref="sftp-custom-error-handler" />
		</try>
		</until-successful>
		<ee:transform doc:name="convert-payload-to-json" doc:id="a543cc4b-19b7-4db5-8bc9-f65ad2657b36">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json deferred=true, indent=false
---
payload]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<batch:job jobName="sftp-inventory-sync-batch-job" doc:id="5b11018a-7764-49c1-9152-07790d4710c9" maxConcurrency="${batch.concurrency}" maxFailedRecords="${batch.maxFailed}" blockSize="${batch.blockSize}">
			<batch:process-records>
				<batch:step name="batch-step-valid-records" doc:id="3eaef80a-6c52-4dbf-a16d-987cbf0b3315" acceptExpression='#[((!isEmpty(payload.SKU) and !isEmpty(payload.StoreId) and !isEmpty(payload.Type) and !isEmpty(payload.Quantity) and !isEmpty(payload.Timestamp) ) and !contains(payload.Quantity as Number  default 0.1,/[\.-]/) and contains(["Backorder","Standard"], payload.Type))]'>
					<batch:aggregator doc:name="batch-aggregator-valid-records" doc:id="364a9622-4ded-4dc8-9ef1-c457bf2efa37" streaming="true" preserveMimeTypes="true">
						<ee:transform doc:name="group-data-by-StoreId" doc:id="744549dc-1f74-480b-8aeb-74ffe891ea96">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/json deferred=true, indent=false
---
payload groupBy($.StoreId) pluck($)]]></ee:set-payload>
						</ee:message>
					</ee:transform>
						<flow-ref doc:name="flow-reference-create-success-records-for-each-subflow" doc:id="d682936e-bfd6-414f-9299-6222fefe2f4c" name="create-success-records-for-each-subflow"/>
					</batch:aggregator>
				</batch:step>
				<batch:step name="batch-step-error-records" doc:id="64721d0a-a0b5-4fd3-8787-5c1e416bc08f" acceptExpression='#[!((!isEmpty(payload.SKU) and !isEmpty(payload.StoreId) and !isEmpty(payload.Type) and !isEmpty(payload.Quantity) and !isEmpty(payload.Timestamp) ) and !contains(payload.Quantity as Number  default 0.1,/[\.-]/) and contains(["Backorder","Standard"], payload.Type))]' acceptPolicy="ALL">
					<batch:aggregator doc:name="batch-aggregator-valid-records" doc:id="fb6e4aef-ed33-4a58-8d06-4060c960d144" preserveMimeTypes="true" streaming="true">
						<flow-ref doc:name="flow-reference-create-success-records-subflow" doc:id="e1588395-9d56-4401-a385-8914daba8279" name="create-error-records-subflow"/>
					</batch:aggregator>
				</batch:step>
			</batch:process-records>
			<batch:on-complete >
				<logger level="INFO" doc:name="logger-on-complete-batch" doc:id="3159be8a-81b7-4a77-aed5-a185bef33a61" message="#[output application/json&#10;---&#10;{&#10;	&quot;appName&quot;: p('app.name'),&#10;	&quot;correlationId&quot;: correlationId,&#10;	&quot;timeStamp&quot;: now(),&#10;	&quot;message&quot;: &quot;Batch Job Completed&quot;&#10;}]"/>
				<os:retrieve-all doc:name="retrieve-the-success" doc:id="8069455b-0e40-4caa-afab-06ae8f045985" objectStore="Object_store1" target="success"/>
				<os:retrieve-all doc:name="retrieve-cb-status" doc:id="db17a82e-ae8a-44da-b1d9-d707bc958dbb" objectStore="Object_store_cb" target="cbStatus"/>
				<ee:transform doc:name="email-body" doc:id="fbad078b-a981-473c-b250-1ddad664cb35" >
					<ee:message >
						<ee:set-payload ><![CDATA[output application/java
var date= write((now() as Date {format:"MM-dd-yy"}),"application/json")
---
("Hi Team,
The nightly inventory synchronization from Oracle WMS to Salesforce Commerce Cloud (SFCC) has completed successfully.

Sync Summary:
-------------------------------------------
DateTime: $(now() as String {format: 'MMM dd, yyyy HH:mm:ss'})
Job Instance ID: $(correlationId)
Source File: full_inventory_$(date[1 to -2]).csv"++
if(vars.cbStatus.cb default false)
	if(!isEmpty(vars.success))
"
The nightly Oracle WMS to SFCC inventory sync has been interrupted by an sFTP error.
Operations will remain paused until the connection is restored.
In the interim, all pending records are being backed up for subsequent reprocessing.
Valid records which are synced till the error can be found at /$((p('sftp.targetPath'))[0 to -2]) directory.
Any records that failed validation have been stored at /$((p('sftp.errorPath'))[0 to -2]) directory for the Technical Support Team to manual review."
	else
		"
The nightly Oracle WMS to SFCC inventory sync has been interrupted by an sFTP error.
Operations will remain paused until the connection is restored."
else
"
All successfully synced records met the mandatory criteria can be found at /$((p('sftp.targetPath'))[0 to -2]) directory.
Any records that failed validation have been stored at /$((p('sftp.errorPath'))[0 to -2]) directory for the Technical Support Team to manual review.

Regards,
Mulesoft Integration") as String]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<email:send doc:name="send-email" doc:id="55347a07-07a2-459e-91a2-aeab55dc6bcf" config-ref="Email_SMTP" fromAddress="${smtp.user}" subject='#["Inventory Sync Completion - Oracle WMS to SFCC - "++ (now() as String {format: "MM-dd-yy"})]'>
					<email:to-addresses >
						<email:to-address value="#[p('smtp.receiver')]" />
					</email:to-addresses>
					<email:body contentType="text/plain" />
				</email:send>
			</batch:on-complete>
		</batch:job>
	</flow>
