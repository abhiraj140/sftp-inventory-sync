	<sub-flow name="store-new-fileName-subflow" doc:id="6673a914-cff2-45d6-81eb-4416fe5d5772" >
		<choice doc:name="Choice" doc:id="0aabaad8-70c7-4bca-95e4-220a3539d901" >
			<when expression="#[(vars.cbOpen default false)]">
				<logger level="INFO" doc:name="logger-cb-open" doc:id="bc6b9871-f0fa-46f4-8ab1-fc0806a88030" message="#[output application/json&#10;---&#10;{&#10;	&quot;appName&quot;: p('app.name'),&#10;	&quot;correlationId&quot;: correlationId,&#10;	&quot;timeStamp&quot;: now(),&#10;	&quot;message&quot;: &quot;Error in sFTP operation. circuit Breaker is open&quot;,&#10;}]"/>
			</when>
			<otherwise >
				<os:store doc:name="logger-store-fileName" doc:id="80ac847a-a6b0-4a97-b7c3-bb5841daf8a9" objectStore="Object_store1" key="#[vars.fileName]">
							<os:value><![CDATA[#[true]]]></os:value>
						</os:store>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="store-error-filename-subflow" doc:id="82606ef1-1c28-4660-89f4-0f41be42e111" >
		<choice doc:name="Choice" doc:id="99394131-0a9a-42d4-86b9-79a083cab579" >
			<when expression="#[(vars.cbOpen default false)]">
