	<sub-flow name="create-success-records-for-each-subflow" doc:id="95f78330-1363-4c67-9a80-7483f192ad74" >
		<foreach doc:name="For Each" doc:id="8ba7b7d9-a421-4666-84a0-7d3400a2659d">
			<flow-ref doc:name="flow-reference-create-success-records-subflow" doc:id="2db034a7-b3c8-4d07-8197-b05997855a0f" name="create-success-records-subflow"/>
						</foreach>
	</sub-flow>
	<sub-flow name="create-success-records-subflow" doc:id="89dfc619-bbd9-4e2f-aac7-96e858351355" >
		<ee:transform doc:name="set-variable-fileName" doc:id="cea6b817-1348-407f-ae82-7bcb4709789e">
				<ee:message>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="fileName"><![CDATA[%dw 2.0
output application/json
---
("inventory_" ++ payload[0].StoreId ++"_" ++ now() as Date ++ ".csv")]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
		<os:retrieve doc:name="retrieve-cb-status" doc:id="7add15f2-3d1e-410f-a5e0-bba821b58ed3" key="cb" objectStore="Object_store_cb" target="cb">
				<os:default-value><![CDATA[#[false]]]></os:default-value>
			</os:retrieve>
		<choice doc:name="Choice" doc:id="a3fd2859-18a7-4a93-8f68-8fe1f41a249a">
				<when expression="#[vars.cb]">
					<ee:transform doc:name="error-csv-payload" doc:id="debbc200-a6c3-4efd-a2ed-13b784d8f771">
						<ee:message>
							<ee:set-payload><![CDATA[%dw 2.0
output application/csv
---
payload]]></ee:set-payload>
						</ee:message>
					</ee:transform>
					<jms:publish doc:name="publish-to-failedValidQueue" doc:id="8e5d47c9-8a11-438d-8426-4f91fe5f01eb" config-ref="JMS_Config" destination="${jms.validQueue}">
						<jms:message outboundContentType="application/csv" />
					</jms:publish>
				</when>
				<otherwise>
					<os:retrieve-all doc:name="retrieve-created-fileNames" doc:id="02dc2665-97c9-4356-9052-75828792f8f5" objectStore="Object_store1" target="storedFileName" />
					<ee:transform doc:name="set-variable-flag" doc:id="0577cf49-2293-48f4-9cc3-97d45c655f34">
				<ee:message>
				</ee:message>
				<ee:variables>
					<ee:set-variable variableName="flag"><![CDATA[%dw 2.0
output application/json
---
((vars.storedFileName default []) pluck($$ as String) )contains(vars.fileName)]]></ee:set-variable>
					<ee:set-variable variableName="writePath"><![CDATA[%dw 2.0
output application/json
---
p('sftp.targetPath') ++ vars.fileName]]></ee:set-variable>
				</ee:variables>
			</ee:transform>
					<flow-ref doc:name="flow-reference-sftp-write-valid-records-subflow" doc:id="5caa3af8-6738-493a-ac36-bccde9ae7a39" name="sftp-write-valid-records-subflow" />
				</otherwise>
			</choice>
	</sub-flow>
	<sub-flow name="create-error-records-subflow" doc:id="0b37703d-b0d2-48be-865c-8c4335985086" >
