output application/json
---
((vars.storedFileName default []) pluck($$ as String) )contains(vars.errorFilename)]]></ee:set-variable>
				<ee:set-variable variableName="writePath"><![CDATA[%dw 2.0
output application/json
---
p('sftp.errorPath') ++ vars.errorFilename]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
				<flow-ref doc:name="flow-reference-sftp-write-error-records-subflow" doc:id="b5770221-174c-4647-80df-4abb12cdf7a2" name="sftp-write-error-records-subflow"/>
			</otherwise>
		</choice>
	</sub-flow>
