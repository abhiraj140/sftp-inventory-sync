			</when>
			<otherwise >
				<os:store doc:name="store-error-filename" doc:id="c0c60eec-e87d-4663-9e08-54000f56a7a9" objectStore="Object_store1" key="#[vars.errorFilename]">
							<os:value><![CDATA[#[true]]]></os:value>
						</os:store>
			</otherwise>
		</choice>
	</sub-flow>
	<sub-flow name="sftp-write-subflow" doc:id="d1e0cae7-c821-419a-8387-fdea7cb555fe" >
		<try doc:name="Try" doc:id="cdd818d0-22b1-404a-9724-e4b44afc7346" >
			<until-successful maxRetries="${retry.attempt}" doc:name="Until Successful" doc:id="b097a3ee-bd87-4a7b-8256-ed620edb20d0" millisBetweenRetries="${retry.frequency}">
			<try doc:name="Try" doc:id="f57518d2-cc68-491f-ad65-2c9d2104ff63">
			<sftp:write doc:name="write-sftp" doc:id="5f4a0338-8169-4471-9f6b-68b2e84f40fb" config-ref="SFTP_Config" path="#[vars.writePath]" mode="APPEND" />
			<error-handler ref="sftp-custom-error-handler" />
		</try>
		</until-successful>
			<error-handler ref="sftp-custom-error-handler" />
		</try>
	</sub-flow>
</mule>
