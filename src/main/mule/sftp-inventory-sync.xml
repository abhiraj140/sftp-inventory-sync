			<when expression="#[vars.cb]">
				<jms:publish doc:name="publish-to-failedErrorQueue" doc:id="788c97fa-16cb-401f-bce4-b4e3a0fdfe4e" config-ref="JMS_Config" destination="${jms.errorQueue}" persistentDelivery="true">
					<jms:message outboundContentType="application/csv" />
				</jms:publish>
